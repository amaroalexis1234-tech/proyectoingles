# Copia este archivo a .env y completa los valores reales (nunca subir .env a git)

ENVIRONMENT=development
DEBUG=true

# mysql+pymysql://usuario:password@host:puerto/nombre_db
# Si usas el docker-compose.yml incluido en la raíz del proyecto, estos
# valores ya coinciden exactamente (no hay que cambiar nada):
DATABASE_URL=mysql+pymysql://umph_user:umph_password@localhost:3307/umph_db

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_ORIGIN=http://localhost:3000

ANTHROPIC_API_KEY=

# Opcional: sin esto, "olvidé mi contraseña" sigue funcionando en modo
# desarrollo (el enlace se muestra en pantalla en vez de enviarse por correo).
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu
# correo, SMTP_PASSWORD=un "App Password" (myaccount.google.com/apppasswords,
# requiere verificación en dos pasos activada), SMTP_FROM_EMAIL=tu correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
